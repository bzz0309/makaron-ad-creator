  "scripts": {
    "test": "PYTHONDONTWRITEBYTECODE=1 node tests/npm-smoke.mjs && PYTHONDONTWRITEBYTECODE=1 PYTHONPATH=skills/makaron-ad-creator/scripts python3 -m unittest discover -s tests -v",
    "pack:check": "npm pack --dry-run"
