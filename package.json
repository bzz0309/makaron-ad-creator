{
  "name": "makaron-ad-creator-cli",
  "version": "0.6.5",
  "description": "Portable one-image to selected-locale Makaron ad creator CLI for AI agents",
  "type": "module",
  "bin": {
    "makaron-ad": "bin/makaron-ad.mjs",
    "makaron-ad-creator-cli": "bin/makaron-ad.mjs"
