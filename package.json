    "@remotion/renderer": "4.0.506",
    "makaron-cli": "^0.13.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "remotion": "4.0.506"
  },
  "files": [
    "bin/makaron-ad.mjs",
    "skills/",
    "README.md",
    "LICENSE",
    "pyproject.toml"
  ],
  "engines": {
